[
  {
    "context": "Workspace",
    "bindings": {
      "alt-super-j": "terminal_panel::Toggle",
      "ctrl-super-j": "workspace::NewTerminal",
      "alt-super-k": "agent::Toggle",
      "ctrl-super-k": "agent::NewThread",
      "alt-super-l": "multi_workspace::ToggleWorkspaceSidebar",
      "ctrl-super-l": "agents_sidebar::ToggleThreadHistory"
    }
  },
  {
    "context": "Editor",
    "bindings": {
      "ctrl-up": "editor::MoveToStartOfParagraph",
      "ctrl-down": "editor::MoveToEndOfParagraph",

      "alt-shift-left": "editor::SelectToBeginningOfLine",
      "alt-shift-right": "editor::SelectToEndOfLine",

      "ctrl-shift-left": "editor::SelectToPreviousWordStart",
      "ctrl-shift-right": "editor::SelectToNextWordEnd",
      "ctrl-shift-up": "editor::SelectLargerSyntaxNode",
      "ctrl-shift-down": "editor::SelectSmallerSyntaxNode"
    }
  }
]
