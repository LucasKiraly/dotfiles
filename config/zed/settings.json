{
  // General & Privacy
  "base_keymap": "Zed",
  "autosave": "on_window_change",
  "cli_default_open_behavior": "new_window",
  "telemetry": {
    "metrics": false,
    "diagnostics": false,
    "anthropic_retention": false
  },

  // Appearance & Typography
  "theme": "Tokyo Night",
  "ui_font_family": "IBM Plex Sans",
  "ui_font_size": 23.0,
  "buffer_font_family": "JetBrains Mono",
  "buffer_font_size": 25.0,
  "agent_ui_font_size": 21.0,
  "agent_buffer_font_size": 23.0,

  // Interface
  "title_bar": {
    "show_project_items": false,
    "show_branch_name": false,
    "show_sign_in": false
  },
  "tab_bar": {
    "show": false,
    "show_nav_history_buttons": false
  },
  "max_tabs": 3,
  "toolbar": {
    "quick_actions": false
  },
  "scrollbar": {
    "show": "never"
  },

  // Panels
  "project_panel": {
    "dock": "left",
    "starts_open": false,
    "default_width": 320.0,
    "hide_root": true,
    "folder_indicator": "icon"
  },
  "terminal": {
    "dock": "right",
    "flexible": false,
    "default_width": 1720.0,
    "font_size": 23.0
  },

  // Agent
  "agent": {
    "dock": "right",
    "flexible": false,
    "default_width": 1720.0,
    "threads_sidebar": {
      "position": "right",
      "default_width": 320.0
    }
  },
  "agent_servers": {
    "antigravity-acp": {
      "type": "registry",
      "default_config_options": {
        "model": "gemini-4-neon",
        "mode": "default",
        "thinking_level": "medium"
      }
    }
  },

  // Editor
  "show_wrap_guides": false,
  "git": {
    "inline_blame": {
      "enabled": false
    }
  },

  // Languages
  "languages": {
    "Python": {
      "language_servers": ["ty", "ruff"],
      "format_on_save": "off",
      "preferred_line_length": 79,
      "show_wrap_guides": true,
      "wrap_guides": [72, 79]
    }
  }
}
